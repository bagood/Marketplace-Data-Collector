# Optional: API-platform authentication. ChatGPT Plus users can leave this
# blank and run: docker compose run --rm codex-login
OPENAI_API_KEY=

# Optional overrides
CODEX_MODEL=gpt-5.5
ANALYSIS_BATCH_SIZE=20
FACEBOOK_DETAIL_WORKERS=2
OLX_DETAIL_WORKERS=2
MCP_PORT=8000

# Optional Google Sheets upload. Generate the Base64 value from the downloaded
# service-account JSON using the command documented in README.md.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET=Ads
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
